{
  "sourceLanguage": "en",
  "strings": {
    "%@ is already used to cycle input sources.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は入力ソースの切り替えに使われています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已用于循环切换输入法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已用於循環切換輸入法。"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        }
      }
    },
    "All Input Sources": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての入力ソース"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部输入法"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部輸入法"
          }
        }
      }
    },
    "Allow Accessibility access": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティへのアクセスを許可"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许辅助功能权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許輔助使用權限"
          }
        }
      }
    },
    "Another system shortcut": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのシステムショートカット"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个系统快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個系統快速鍵"
          }
        }
      }
    },
    "Clear Shortcut": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを消去"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除快速鍵"
          }
        }
      }
    },
    "Configure Shortcuts…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを設定…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置快捷键…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定快速鍵…"
          }
        }
      }
    },
    "Cycle Through": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替え対象"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "循环切换范围"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "循環切換範圍"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Edit Input Sources…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力ソースを編集…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑输入法…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯輸入法…"
          }
        }
      }
    },
    "Edit…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯…"
          }
        }
      }
    },
    "Esc is left for cancelling.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc はキャンセルに使われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc 留作取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc 留作取消。"
          }
        }
      }
    },
    "Hold the modifiers and press the key repeatedly to cycle; add ⇧ to go back.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーを押したままキーを繰り返し押すと順に切り替わります。⇧ を加えると逆方向です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住修饰键并重复按下按键以循环切换，加上 ⇧ 反向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住修飾鍵並重複按下按鍵以循環切換，加上 ⇧ 反向。"
          }
        }
      }
    },
    "IMESwitch needs it to intercept %@ and to find the text cursor.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を受け取り、テキストカーソルの位置を調べるために必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IMESwitch 需要它来接管 %@，并找到文本光标的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "IMESwitch 需要它來接管 %@，並找到文字游標的位置。"
          }
        }
      }
    },
    "In Keyboard Shortcuts, turn off: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーボードショートカット」で次をオフにしてください：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“键盘快捷键”中关闭：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「鍵盤快速鍵」中關閉：%@"
          }
        }
      }
    },
    "Input Sources": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力ソース"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入法"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入法"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後"
          }
        }
      }
    },
    "Launch at Login": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动"
