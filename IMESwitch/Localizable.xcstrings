        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復為 %@"
          }
        }
      }
    },
    "Select next source in Input menu": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力メニューの次のソースを選択"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
