        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時啟動"
          }
        }
      }
    },
    "No system shortcut is using %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を使っているシステムショートカットはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有系统快捷键占用 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有系統快速鍵佔用 %@。"
          }
        }
      }
    },
    "Open Keyboard Settings…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード設定を開く…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开键盘设置…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開鍵盤設定…"
          }
        }
      }
    },
    "Open Settings…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開設定…"
          }
        }
      }
    },
    "Press a shortcut anywhere to switch straight to that input source.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでもショートカットを押すと、その入力ソースに直接切り替わります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意位置按下快捷键，即可直接切换到对应的输入法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何位置按下快速鍵，即可直接切換到對應的輸入法。"
          }
        }
      }
    },
    "Quit IMESwitch": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IMESwitch を終了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 IMESwitch"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束 IMESwitch"
          }
        }
      }
    },
    "Record Shortcut": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを記録"
