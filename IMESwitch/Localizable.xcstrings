          }
        }
      }
    },
    "Show Emoji & Symbols": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字と記号を表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示表情与符号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示表情符號與符號"
          }
        }
      }
    },
    "Show Spotlight search": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight 検索を表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示聚焦搜索"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示 Spotlight 搜尋"
          }
        }
      }
    },
    "Switch Input Sources": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力ソースを切り替える"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换输入法"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換輸入法"
          }
        }
      }
    },
    "Switcher": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチャー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換器"
          }
        }
      }
    },
    "Turn off the system %@ shortcut": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの %@ ショートカットをオフにする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭系统的 %@ 快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉系統的 %@ 快速鍵"
          }
        }
      }
    },
    "Two quick steps and %@ will switch input sources in most-recently-used order.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 つの手順で、%@ で最近使った順に入力ソースを切り替えられるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需两步，%@ 就会按最近使用的顺序切换输入法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只需兩步，%@ 就會依最近使用的順序切換輸入方式。"
          }
        }
      }
    },
    "Type Shortcut…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを入力…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按快捷键…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請按快速鍵…"
          }
        }
      }
    },
    "Type the new shortcut. Esc cancels, Delete clears.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいショートカットを入力してください。Esc でキャンセル、Delete で消去します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按下新的快捷键。Esc 取消，Delete 清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請按下新的快速鍵。Esc 取消，Delete 清除。"
          }
        }
      }
    },
    "Type the new shortcut. Esc cancels, Delete resets to %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいショートカットを入力してください。Esc でキャンセル、Delete で %@ に戻します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按下新的快捷键。Esc 取消，Delete 恢复为 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請按下新的快速鍵。Esc 取消，Delete 恢復為 %@。"
          }
        }
      }
    },
    "Use ⌘, ⌃ or ⌥ with the key, or a function key.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘、⌃、⌥ のいずれかと組み合わせるか、ファンクションキーを使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请搭配 ⌘、⌃ 或 ⌥ 使用，或使用功能键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請搭配 ⌘、⌃ 或 ⌥ 使用，或使用功能鍵。"
          }
        }
      }
    },
    "Use ⌘, ⌃ or ⌥ with the key, to hold down while cycling.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替え中に押し続けるため、⌘、⌃、⌥ のいずれかと組み合わせてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请搭配 ⌘、⌃ 或 ⌥ 使用，循环切换时需要按住它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請搭配 ⌘、⌃ 或 ⌥ 使用，循環切換時需要按住它。"
          }
        }
      }
    },
    "Welcome to IMESwitch": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IMESwitch へようこそ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 IMESwitch"
          }
        },
        "zh-Hant": {
