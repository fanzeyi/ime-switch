{
  "sourceLanguage": "en",
  "strings": {
    "Allow Accessibility access": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティへのアクセスを許可"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许辅助功能权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許輔助使用權限"
          }
        }
      }
    },
    "Clear Shortcut": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを消去"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除快速鍵"
          }
        }
      }
    },
    "Click a shortcut to change it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットをクリックして変更します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按快捷键以更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下快速鍵以更改。"
          }
        }
      }
    },
    "Configure Shortcuts…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを設定…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置快捷键…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定快速鍵…"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Edit Input Sources…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力ソースを編集…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑输入法…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯輸入法…"
          }
        }
      }
    },
    "IMESwitch needs it to intercept ⌘Space and to find the text cursor.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Space を受け取り、テキストカーソルの位置を調べるために必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IMESwitch 需要它来接管 ⌘Space，并找到文本光标的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "IMESwitch 需要它來接管 ⌘Space，並找到文字游標的位置。"
          }
        }
      }
    },
    "In Keyboard Shortcuts, turn off: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーボードショートカット」で次をオフにしてください：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“键盘快捷键”中关闭：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「鍵盤快速鍵」中關閉：%@"
          }
        }
      }
    },
    "Input Source Shortcuts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力ソースのショートカット"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入法快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入法快速鍵"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後"
          }
        }
      }
    },
    "Launch at Login": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時啟動"
          }
        }
      }
    },
    "No system shortcut is using ⌘Space.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Space を使っているシステムショートカットはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有系统快捷键占用 ⌘Space。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有系統快速鍵佔用 ⌘Space。"
          }
        }
      }
    },
    "Open Keyboard Settings…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード設定を開く…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开键盘设置…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開鍵盤設定…"
          }
        }
      }
    },
    "Open Settings…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開設定…"
          }
        }
      }
    },
    "Press a shortcut anywhere to switch straight to that input source.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでもショートカットを押すと、その入力ソースに直接切り替わります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意位置按下快捷键，即可直接切换到对应的输入法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何位置按下快速鍵，即可直接切換到對應的輸入法。"
          }
        }
      }
    },
    "Quit IMESwitch": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IMESwitch を終了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 IMESwitch"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束 IMESwitch"
          }
        }
      }
    },
    "Record Shortcut": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを記録"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製快速鍵"
          }
        }
      }
    },
    "Select next source in Input menu": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力メニューの次のソースを選択"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择输入法菜单中的下一个输入法"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇輸入方式選單中的下一個輸入方式"
          }
        }
      }
    },
    "Select the previous input source": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の入力ソースを選択"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择上一个输入法"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇上一個輸入方式"
          }
        }
      }
    },
    "Set Up IMESwitch": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IMESwitch の設定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 IMESwitch"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 IMESwitch"
          }
        }
      }
    },
    "Show Spotlight search": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight 検索を表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示聚焦搜索"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示 Spotlight 搜尋"
          }
        }
      }
    },
    "Turn off the system ⌘Space shortcut": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの ⌘Space ショートカットをオフにする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭系统的 ⌘Space 快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉系統的 ⌘Space 快速鍵"
          }
        }
      }
    },
    "Two quick steps and ⌘Space will switch input sources in most-recently-used order.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 つの手順で、⌘Space で最近使った順に入力ソースを切り替えられるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需两步，⌘Space 就会按最近使用的顺序切换输入法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只需兩步，⌘Space 就會依最近使用的順序切換輸入方式。"
          }
        }
      }
    },
    "Type Shortcut…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを入力…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按快捷键…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請按快速鍵…"
          }
        }
      }
    },
    "Type the new shortcut. Esc cancels, Delete clears.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいショートカットを入力してください。Esc でキャンセル、Delete で消去します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按下新的快捷键。Esc 取消，Delete 清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請按下新的快速鍵。Esc 取消，Delete 清除。"
          }
        }
      }
    },
    "Use ⌘, ⌃ or ⌥ with the key, or a function key.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘、⌃、⌥ のいずれかと組み合わせるか、ファンクションキーを使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请搭配 ⌘、⌃ 或 ⌥ 使用，或使用功能键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請搭配 ⌘、⌃ 或 ⌥ 使用，或使用功能鍵。"
          }
        }
      }
    },
    "Welcome to IMESwitch": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IMESwitch へようこそ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 IMESwitch"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎使用 IMESwitch"
          }
        }
      }
    },
    "macOS already uses this shortcut. Pick another, or turn it off in Keyboard Shortcuts.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットは macOS で使われています。別のものを選ぶか、「キーボードショートカット」でオフにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已占用此快捷键。请换一个，或在“键盘快捷键”中将其关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已佔用此快速鍵。請換一個，或在「鍵盤快速鍵」中將其關閉。"
          }
        }
      }
    },
    "macOS also uses this shortcut, so it may not work.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットは macOS でも使われているため、動作しない場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 也在使用此快捷键，可能无法生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 也在使用此快速鍵，可能無法生效。"
          }
        }
      }
    },
    "⌘Space is already used to cycle input sources.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Space は入力ソースの切り替えに使われています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Space 已用于循环切换输入法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Space 已用於循環切換輸入法。"
          }
        }
      }
    },
    "⚠️ Finish Setup…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 設定を完了…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 完成设置…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 完成設定…"
          }
        }
      }
    }
  },
  "version": "1.0"
}
